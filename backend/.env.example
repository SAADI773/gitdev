# Required — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional but recommended — raises GitHub API rate limit from 60/hr to 5000/hr
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_personal_access_token_here

PORT=5000
